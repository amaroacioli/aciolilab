{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/delivery-preview.ts": {
      "includeFiles": "dist/index.html",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/entregas/:slug",
      "destination": "/api/delivery-preview?slug=:slug"
    },
    {
      "source": "/api/delivery-preview",
      "destination": "/api/delivery-preview"
    },
    {
      "source": "/copyacioli",
      "destination": "/copyacioli.html"
    },
    {
      "source": "/copyacioli/",
      "destination": "/copyacioli.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
